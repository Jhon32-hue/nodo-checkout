  "info": {
    "title": "Payment Checkout API",
    "description": "Backend API for the payment checkout application.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "sku": {
            "type": "string",
            "example": "AUD-001",
            "maxLength": 64
          },
          "category": {
            "type": "string",
            "enum": [
              "audio",
              "computacion",
              "accesorios",
              "almacenamiento",
              "hogar-inteligente",
              null
            ],
            "nullable": true,
            "example": "audio",
            "description": "Categoría; null solo para registros ajenos sin clasificar."
          },
          "name": {
            "type": "string",
            "example": "Auriculares inalámbricos Nova",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "example": "Auriculares Bluetooth con micrófono integrado, controles táctiles y estuche de carga USB-C. Diseño compacto para llamadas, música y uso diario. Incluyen cable de carga y almohadillas."
          },
          "imageUrl": {
            "type": "string",
            "example": "https://placehold.co/800x600/png?text=Auriculares",
            "maxLength": 2048
          },
          "unitPriceCents": {
            "type": "integer",
            "example": 12990000,
            "description": "Centavos enteros COP: 12990000 centavos = 129900 COP.",
            "minimum": 1,
            "maximum": 2000000000
          },
          "currency": {
            "type": "string",
            "enum": ["COP"],
            "example": "COP"
          },
          "available": {
            "type": "integer",
            "example": 10,
            "minimum": 0,
            "description": "Stock menos reservas comprometidas. Cero sigue siendo consultable."
          }
        },
        "required": [
          "id",
          "sku",
          "category",
          "name",
          "description",
          "imageUrl",
          "unitPriceCents",
          "currency",
          "available"
        ]
      },
      "ProductListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductDto"
            }
          }
        },
        "required": ["items"]
      },
      "ProductListEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProductListDto"
          }
        },
        "required": ["data"]
      },
      "CatalogErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_PRODUCT_ID",
              "INVALID_QUERY_PARAMS",
              "PRODUCT_NOT_FOUND",
              "CATALOG_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string",
            "example": "Producto no encontrado."
          }
        },
        "required": ["code", "message"]
      },
      "CatalogErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/CatalogErrorDto"
          }
        },
        "required": ["error"]
      },
      "ProductEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProductDto"
          }
        },
        "required": ["data"]
      },
      "BuyerDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 16,
            "pattern": "^\\+[1-9]\\d{1,14}$"
          }
        },
        "required": ["fullName", "email", "phone"]
      },
      "DeliveryDto": {
        "type": "object",
        "properties": {
          "recipientName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 16,
            "pattern": "^\\+[1-9]\\d{1,14}$"
          },
          "addressLine1": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "addressLine2": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "country": {
            "type": "string",
            "enum": ["CO"]
          },
          "postalCode": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 12
          }
        },
        "required": [
          "recipientName",
          "phone",
          "addressLine1",
          "city",
          "region",
          "country"
        ]
      },
      "CreateCheckoutDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": ["productId", "quantity"]
      },
      "PatchCheckoutDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "buyer": {
            "$ref": "#/components/schemas/BuyerDto"
          },
          "delivery": {
            "$ref": "#/components/schemas/DeliveryDto"
          }
        }
      }
    }
  }
}
